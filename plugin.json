{
    "name": "Dixlase Menus",
    "package_name": "dixlase/dixlase-menus",
    "slug": "dixlase-menus",
    "version": "0.1.0",
    "description": {
        "ja": "メニュー管理機能を提供するプラグインです。",
        "en": "This plugin provides menu management functionality."
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "info@dixlase.org",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE.commercial",
        "contact": "info@dixlase.org"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "namespace": "Plugins\\DixlaseMenus",
    "providers": [
        "Plugins\\DixlaseMenus\\App\\Providers\\DixlaseMenusServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "navigation",
    "tags": [
        "menu",
        "navigation",
        "cms"
    ],
    "capabilities": [
        "multilingual-content"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-menus:menu",
                "model": "Plugins\\DixlaseMenus\\App\\Models\\Menu",
                "label_field": "name",
                "fields": []
            }
        ]
    },
    "requires": {
        "dixlase": "^0.1.0",
        "php": ">=8.0"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": false,
        "api_routes": false,
        "settings_page": true
    },
    "declares": {
        "configs": {
            "roles": false,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": [
                "js/app.js"
            ],
            "admin": [
                "admin/js/app.js"
            ],
            "front": []
        },
        "contracts": [
            "MenuItemRepositoryInterface",
            "MenuLinkSource",
            "MenuRepositoryInterface",
            "MenuSettingRepositoryInterface"
        ],
        "migrations": true,
        "commands": false,
        "middleware": false
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": false,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": false,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": true,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": true,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "ja": "",
            "en": ""
        }
    }
}
